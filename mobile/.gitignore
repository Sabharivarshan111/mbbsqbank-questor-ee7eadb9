# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Preview harness build output (dev-only tool, not part of the app)
preview/dist/

# Release signing — keep keystore secrets out of git
android/gradle.properties.local
*.jks

# JS bundle + assets embedded into a sideloadable debug APK by CI. Generated,
# never committed: a stale copy here would silently override the real bundle.
android/app/src/main/assets/index.android.bundle
android/app/src/main/res/drawable-*/
android/app/src/main/res/raw/
