{
  // A separate config on purpose.
  //
  // The preview runs in a browser through react-native-web, so it legitimately
  // uses `window`, `document` and react-dom. The app's tsconfig must NOT gain
  // the "dom" lib to accommodate that: React Native has no `window`, and adding
  // it would let app code reference one, typecheck clean, and crash on a phone.
  //
  // Before this file existed, `preview/**` was simply not typechecked at all —
  // a missing import there only surfaced when the harness was next run.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["react-dom"],
    "noEmit": true,
    "paths": {
      "@/*": ["../src/*"],
      "@data/*": ["../../src/data/*"],
      "@shared/*": ["../../src/lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["dist", "**/node_modules"]
}
